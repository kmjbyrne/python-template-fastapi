# Copy to .env and edit. Every setting in app/config.py can be overridden here;
# these are the ones that usually need it. Real environment variables win over
# anything set in a file.

PROJECT_NAME="CHANGEME"
ENVIRONMENT="development"  # development, test, staging, production

# Logging goes to stdout. Set LOG_JSON=true for one JSON object per line.
LOG_LEVEL="INFO"
LOG_JSON="false"

# JSON list of origins allowed by the CORS middleware.
CORS_ORIGINS='["http://localhost:3000"]'

# Drop this line if you eject the persistence layer.
DATABASE_URL="sqlite:///instance/database.db"
